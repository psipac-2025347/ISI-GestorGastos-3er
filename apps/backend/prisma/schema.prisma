generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  incomes   Income[]
  expenses  Expense[]
  emergencyFundMovements  EmergencyFundMovement[]
  @@map("users")
}
enum IncomeType {
  FIJO
  VARIABLE
  EXTRA
}

model Income {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  type          IncomeType
  grossAmount   Decimal    @db.Decimal(10, 2)
  deduction     Decimal    @default(0) @db.Decimal(10, 2)
  netAmount     Decimal    @db.Decimal(10, 2)
  description   String?
  date          DateTime   @default(now())
  createdAt     DateTime   @default(now())

  @@map("incomes")
}

enum ExpenseCategory {
  COMIDA
  TRANSPORTE
  SERVICIOS
  ENTRETENIMIENTO
  SALUD
  OTROS
}

model Expense {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  type         IncomeType
  category     ExpenseCategory @default(OTROS)
  grossAmount  Decimal         @db.Decimal(10, 2)
  tax          Decimal         @default(0) @db.Decimal(10, 2)
  netAmount    Decimal         @db.Decimal(10, 2)
  description  String?
  date         DateTime        @default(now())
  createdAt    DateTime        @default(now())

  @@map("expenses")
}
enum FundMovementType {
  APORTE
  RETIRO
  GASTO_DIRECTO
}

model EmergencyFundMovement {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  movementType FundMovementType
  sourceType   IncomeType?
  grossAmount  Decimal           @db.Decimal(10, 2)
  tax          Decimal           @default(0) @db.Decimal(10, 2)
  netAmount    Decimal           @db.Decimal(10, 2)
  description  String?
  date         DateTime          @default(now())
  createdAt    DateTime          @default(now())

  @@map("emergency_fund_movements")
}